GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=128
GEMINI_DAILY_REQUEST_LIMIT=20
HANDOFF_ENCRYPTION_KEY=
# Sites Worker server secrets. Never prefix these with VITE_.
OPENAI_API_KEY=
EXTERNAL_WEB_SEARCH_ENABLED=false
EXTERNAL_WEB_SEARCH_MODEL=gpt-5.6-luna
EXTERNAL_WEB_SEARCH_ALLOWED_DOMAINS=scllab.co.kr,kdca.go.kr,mfds.go.kr,hira.or.kr,pubmed.ncbi.nlm.nih.gov,clinicaltrials.gov,who.int,cdc.gov,fda.gov
EXTERNAL_WEB_SEARCH_TIMEOUT_MS=15000

# Optional HTTPS backend origin; API business rules run only on Python when configured.
BACKEND_API_URL=
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=10000
