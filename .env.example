# Backend only. Never expose this value through VITE_* variables.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_VECTOR_STORE_ID=
VECTOR_SEARCH_ENABLED=false
VECTOR_SEARCH_SHADOW_MODE=false
VECTOR_SEARCH_MAX_RESULTS=12
VECTOR_SEARCH_MIN_SCORE=0.25
VECTOR_SEARCH_TIMEOUT_SECONDS=10
OPENAI_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_INPUT_CHARS=500
SESSION_HISTORY_LIMIT=8
RESULT_PROVIDER_MODE=unconfigured
# RESULT_PROVIDER_MODE=http일 때만 사용합니다. 운영 주소는 HTTPS여야 합니다.
RESULT_API_BASE_URL=
RESULT_API_AUTH_PATH=/v1/auth/sessions
RESULT_API_LIST_PATH=/v1/results
RESULT_API_DETAIL_PATH=/v1/results/{result_id}
RESULT_API_LOGOUT_PATH=/v1/auth/logout
RESULT_API_CLIENT_ID=
RESULT_API_CLIENT_SECRET=
RESULT_API_CA_BUNDLE=
RESULT_API_CLIENT_CERT=
RESULT_API_CLIENT_KEY=
RESULT_API_TIMEOUT_SECONDS=15
RESULT_API_ALLOW_HTTP=false
RESULT_SESSION_TTL_MINUTES=15
# 운영에서는 Fernet 키를 환경변수로 주입하세요. 비우면 로컬 전용 키가 data/.field-encryption.key에 생성됩니다.
FIELD_ENCRYPTION_KEY=
ATTACHMENT_MAX_BYTES=104857600
OCR_ENABLED=true
# 비우면 PATH와 Windows 표준 설치 경로에서 자동 탐지합니다.
OCR_TESSERACT_CMD=
# 비우면 data/ocr/tessdata 또는 Tesseract 설치 폴더를 사용합니다.
OCR_TESSDATA_DIR=
OCR_LANGUAGES=kor+eng
OCR_DPI=180
OCR_TIMEOUT_SECONDS=180
OCR_MAX_PAGES=250
OCR_MAX_IMAGE_PIXELS=8000000
OCR_PSM=3
# legacy .doc 변환용 LibreOffice. 비우면 표준 설치 경로에서 자동 탐지합니다.
OFFICE_CONVERTER_CMD=
OFFICE_CONVERTER_TIMEOUT_SECONDS=120
# 생략하면 data/scl_catalog.db SQLite를 사용합니다.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/scl_chat
SEED_DEMO_ON_EMPTY=true
SCL_CRAWL_DELAY_SECONDS=0.25
SCL_CRAWL_PAGE_SIZE=50
SCL_INACTIVE_AFTER_MISSES=3

# Frontend
VITE_CHAT_API_URL=http://localhost:8000/api/chat
