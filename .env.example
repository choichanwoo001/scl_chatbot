# Backend only. Never expose this value through VITE_* variables.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=128
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_VECTOR_INDEX_PATH=data/gemini_vector_index.json
# Optional legacy provider: only used with LLM_PROVIDER=openai.
OPENAI_API_KEY=
# request-logger 같은 OpenAI 호환 프록시를 사용할 때만 설정합니다.
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_VECTOR_STORE_ID=
VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_SHADOW_MODE=false
VECTOR_SEARCH_MAX_RESULTS=12
VECTOR_SEARCH_MIN_SCORE=0.25
VECTOR_SEARCH_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
# OpenAI 전용 선택 기능입니다. Gemini 모드에서는 호출하지 않습니다.
EXTERNAL_WEB_SEARCH_ENABLED=false
EXTERNAL_WEB_SEARCH_MODEL=gpt-5.6-luna
EXTERNAL_WEB_SEARCH_ALLOWED_DOMAINS=scllab.co.kr,kdca.go.kr,mfds.go.kr,hira.or.kr,pubmed.ncbi.nlm.nih.gov,clinicaltrials.gov,who.int,cdc.gov,fda.gov
EXTERNAL_WEB_SEARCH_TIMEOUT_SECONDS=15
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
MAX_INPUT_CHARS=500
SESSION_HISTORY_LIMIT=8
RESULT_PROVIDER_MODE=unconfigured
# RESULT_PROVIDER_MODE=http일 때만 사용합니다. 운영 주소는 HTTPS여야 합니다.
RESULT_API_BASE_URL=
RESULT_API_AUTH_PATH=/v1/auth/sessions
RESULT_API_LIST_PATH=/v1/results
RESULT_API_DETAIL_PATH=/v1/results/{result_id}
RESULT_API_LOGOUT_PATH=/v1/auth/logout
RESULT_API_CLIENT_ID=
RESULT_API_CLIENT_SECRET=
RESULT_API_CA_BUNDLE=
RESULT_API_CLIENT_CERT=
RESULT_API_CLIENT_KEY=
RESULT_API_TIMEOUT_SECONDS=15
RESULT_API_ALLOW_HTTP=false
RESULT_SESSION_TTL_MINUTES=15
# 운영에서는 Fernet 키를 환경변수로 주입하세요. 비우면 로컬 전용 키가 data/.field-encryption.key에 생성됩니다.
FIELD_ENCRYPTION_KEY=
ATTACHMENT_MAX_BYTES=104857600
OCR_ENABLED=true
# 비우면 PATH와 Windows 표준 설치 경로에서 자동 탐지합니다.
OCR_TESSERACT_CMD=
# 비우면 data/ocr/tessdata 또는 Tesseract 설치 폴더를 사용합니다.
OCR_TESSDATA_DIR=
OCR_LANGUAGES=kor+eng
OCR_DPI=180
OCR_TIMEOUT_SECONDS=180
OCR_MAX_PAGES=250
OCR_MAX_IMAGE_PIXELS=8000000
OCR_PSM=3
# legacy .doc 변환용 LibreOffice. 비우면 표준 설치 경로에서 자동 탐지합니다.
OFFICE_CONVERTER_CMD=
OFFICE_CONVERTER_TIMEOUT_SECONDS=120
# 개발 기본값은 SQLite입니다. production에서는 명시적 PostgreSQL URL과 암호화 키가 필수입니다.
APP_ENV=development
# 실행 계정: scl_app (API) / scl_ingest (수집 배치). 비밀번호는 URL 인코딩하세요.
# DATABASE_URL=postgresql+psycopg://scl_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Alembic/일회성 적재 전용 계정. API 실행 시 주입하지 마세요.
MIGRATION_DATABASE_URL=
# Dedicated ingestion credential. Use as DATABASE_URL only for ingestion processes.
INGEST_DATABASE_URL=
# Optional helper inputs: python scripts/configure_supabase_connection.py
# Use the exact Session pooler host from the existing project's Connect screen.
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
DATABASE_SCHEMA=app
DATABASE_POOL_MODE=session
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=15
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# 운영 인증서 검증: URL에 sslmode=verify-full&sslrootcert=CA_FILE_PATH 지정
SEED_DEMO_ON_EMPTY=false
SCL_CRAWL_DELAY_SECONDS=0.25
SCL_CRAWL_PAGE_SIZE=50
SCL_INACTIVE_AFTER_MISSES=3

# Frontend
VITE_CHAT_API_URL=http://localhost:8000/api/chat

# Expiring shared chat sessions (seconds / maximum retained sessions).
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=10000
