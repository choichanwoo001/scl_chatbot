# Copy this file to .env. The backend, Vite and Docker Compose all read this one file.

# AI response and local vector search
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=128
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_VECTOR_INDEX_PATH=data/gemini_vector_index.json
VECTOR_SEARCH_ENABLED=true
LLM_TIMEOUT_SECONDS=30

# Local FastAPI database. Production mode requires PostgreSQL and FIELD_ENCRYPTION_KEY.
APP_ENV=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
INGEST_DATABASE_URL=
DATABASE_SCHEMA=app
DATABASE_POOL_MODE=session
FIELD_ENCRYPTION_KEY=
SEED_DEMO_ON_EMPTY=false

# Sites Worker -> Supabase HTTPS RPC. Set the same values in Sites runtime variables.
SUPABASE_URL=https://twvjibwtlszoyaywrxdf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_MS=5000
SUPABASE_CACHE_TTL_SECONDS=60

# Sites Worker persistence and encrypted handoff
HANDOFF_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=10000
